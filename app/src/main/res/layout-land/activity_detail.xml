<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/bg_primary">

    <LinearLayout
        android:layout_width="260dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/green_dark"
        android:gravity="center"
        android:padding="20dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:text="← Kembali"
            android:textSize="12sp"
            android:backgroundTint="@color/green_medium"
            android:textColor="@color/white"
            android:layout_marginBottom="16dp"
            style="@style/Widget.MaterialComponents.Button" />

        <TextView
            android:id="@+id/tvEmojiDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌿"
            android:textSize="56sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvNamaDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jahe"
            android:textColor="@color/white"
            android:textSize="26sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvNamaLatinDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Zingiber officinale"
            android:textColor="@color/green_light"
            android:textSize="12sp"
            android:textStyle="italic"
            android:gravity="center"
            android:layout_marginTop="4dp" />

        <View
            android:layout_width="60dp"
            android:layout_height="2dp"
            android:background="@color/green_light"
            android:alpha="0.5"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvKategoriDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rimpang"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:background="@drawable/bg_badge"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/tvAsal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📍 Asia Tenggara"
            android:textColor="@color/green_light"
            android:textSize="12sp"
            android:layout_marginTop="10dp" />

    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/white"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✅ Manfaat"
                        android:textColor="@color/green_dark"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvManfaat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="• Meredakan mual dan muntah&#10;• Anti-inflamasi alami&#10;• Menghangatkan tubuh&#10;• Meningkatkan sistem imun&#10;• Melancarkan pencernaan"
                        android:textColor="@color/text_dark"
                        android:textSize="13sp"
                        android:lineSpacingExtra="4dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/white"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌱 Bagian yang Digunakan"
                        android:textColor="@color/green_dark"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/tvBagianPakai"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Rimpang (akar)"
                        android:textColor="@color/text_dark"
                        android:textSize="13sp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/white"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🧪 Cara Penggunaan"
                        android:textColor="@color/green_dark"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/tvCaraPenggunaan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Parut atau iris tipis rimpang jahe, kemudian rebus dengan 2 gelas air selama 15 menit. Saring dan minum selagi hangat."
                        android:textColor="@color/text_dark"
                        android:textSize="13sp"
                        android:lineSpacingExtra="4dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/warning_bg"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚠️ Peringatan"
                        android:textColor="@color/warning_text"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/tvPeringatan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Hindari konsumsi berlebihan. Konsultasikan dengan dokter jika sedang mengonsumsi obat-obatan tertentu."
                        android:textColor="@color/warning_text"
                        android:textSize="13sp"
                        android:lineSpacingExtra="4dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
